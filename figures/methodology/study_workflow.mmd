    pipelines["Save 26 primary pipelines and ten matched-MI pipelines"]
    preprocess --> finalFull --> finalReduce --> pipelines
  end
  development --> foldFit
  development --> preprocess
  settings --> finalFull
  pipelines --> finalTest["Compare fixed test predictions: performance, classes and costs"]
